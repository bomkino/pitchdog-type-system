{
  "meta": {
    "name": "pitch.dog Type System",
    "version": "13.1.1",
    "displayVersion": "13",
    "status": "production",
    "fontSource": "FontBlind-Final-2026-08-28-v13.zip",
    "principle": "Anchor-locked variable typography"
  },
  "foundation": {
    "density": {
      "comfortable": {
        "controlHeight": "3.25rem",
        "controlPaddingInline": "1.125rem",
        "rowMinHeight": "3.5rem",
        "gap": "1rem"
      },
      "default": {
        "controlHeight": "3rem",
        "controlPaddingInline": "1rem",
        "rowMinHeight": "3.25rem",
        "gap": ".75rem"
      },
      "compact": {
        "controlHeight": "2.5rem",
        "controlPaddingInline": ".75rem",
        "rowMinHeight": "2.75rem",
        "gap": ".5rem",
        "pointerOnly": true
      }
    },
    "touchTarget": {
      "minimum": "2.75rem",
      "preferred": "3rem",
      "coarsePointer": "3rem"
    },
    "focusRing": {
      "width": "2px",
      "offset": "3px"
    },
    "rules": [
      "Density changes spacing and control geometry before it changes type size.",
      "Never animate font weight for hover or selection because width changes destabilise interfaces.",
      "Head is reserved for onboarding, empty states and rare moments of delight. Productive UI remains Body-led.",
      "Eyebrow is metadata and literal data, not the default interface voice."
    ]
  },
  "roles": {
    "ui.display": {
      "family": "head",
      "weight": 500,
      "ital": 0,
      "size": "clamp(2.375rem, 1.86rem + 1.6vi, 3.75rem)",
      "lineHeight": 0.98,
      "tracking": "-0.026em",
      "use": "Onboarding, empty-state and celebratory display only"
    },
    "ui.pageTitle": {
      "family": "body",
      "weight": 700,
      "style": "normal",
      "size": "clamp(1.75rem, 1.55rem + .62vi, 2.25rem)",
      "lineHeight": 1.08,
      "tracking": "-0.021em",
      "use": "Primary title of an application view"
    },
    "ui.sectionTitle": {
      "family": "body",
      "weight": 600,
      "style": "normal",
      "size": "clamp(1.3125rem, 1.22rem + .29vi, 1.5625rem)",
      "lineHeight": 1.16,
      "tracking": "-0.013em",
      "use": "Major region within a view"
    },
    "ui.panelTitle": {
      "family": "body",
      "weight": 600,
      "style": "normal",
      "size": "clamp(1.0625rem, 1.025rem + .12vi, 1.1875rem)",
      "lineHeight": 1.2,
      "tracking": "-0.008em",
      "use": "Cards, dialogs, toasts and panels"
    },
    "ui.body": {
      "family": "body",
      "weight": 400,
      "style": "normal",
      "size": "clamp(1rem, .981rem + .06vi, 1.0625rem)",
      "lineHeight": 1.48,
      "tracking": "0em",
      "use": "Default interface copy"
    },
    "ui.bodyCompact": {
      "family": "body",
      "weight": 400,
      "style": "normal",
      "size": "clamp(.9375rem, .919rem + .055vi, 1rem)",
      "lineHeight": 1.42,
      "tracking": ".001em",
      "use": "Dense tables, lists and secondary interface copy"
    },
    "ui.label": {
      "family": "body",
      "weight": 600,
      "style": "normal",
      "size": "clamp(.875rem, .856rem + .055vi, .9375rem)",
      "lineHeight": 1.22,
      "tracking": ".006em",
      "use": "Form labels and compact headings"
    },
    "ui.action": {
      "family": "body",
      "weight": 600,
      "style": "normal",
      "size": "clamp(.9375rem, .919rem + .055vi, 1rem)",
      "lineHeight": 1.1,
      "tracking": "-.002em",
      "use": "Buttons, tabs and primary navigation"
    },
    "ui.input": {
      "family": "body",
      "weight": 400,
      "style": "normal",
      "size": "clamp(1rem, .981rem + .06vi, 1.0625rem)",
      "lineHeight": 1.25,
      "tracking": "0em",
      "use": "Input values, selections and editable fields"
    },
    "ui.caption": {
      "family": "body",
      "weight": 400,
      "style": "normal",
      "size": "clamp(.8125rem, .794rem + .055vi, .875rem)",
      "lineHeight": 1.38,
      "tracking": ".004em",
      "use": "Help, timestamps and non-essential supporting copy"
    },
    "ui.badge": {
      "family": "eyebrow",
      "weight": 600,
      "width": 87.5,
      "ital": 0,
      "size": "clamp(.6875rem, .669rem + .055vi, .75rem)",
      "lineHeight": 1.0,
      "tracking": ".055em",
      "use": "Short status and category badges"
    },
    "ui.metadata": {
      "family": "eyebrow",
      "weight": 500,
      "width": 87.5,
      "ital": 0,
      "size": "clamp(.75rem, .731rem + .055vi, .8125rem)",
      "lineHeight": 1.25,
      "tracking": ".04em",
      "use": "Versions, dates, dimensions and file facts"
    },
    "ui.data": {
      "family": "eyebrow",
      "weight": 500,
      "width": 87.5,
      "ital": 0,
      "size": "clamp(.8125rem, .794rem + .055vi, .875rem)",
      "lineHeight": 1.25,
      "tracking": ".006em",
      "numeric": "tabular-nums lining-nums slashed-zero",
      "use": "Aligned numbers, prices, counts and durations"
    },
    "ui.code": {
      "family": "eyebrow",
      "weight": 400,
      "width": 87.5,
      "ital": 0,
      "size": "clamp(.8125rem, .794rem + .055vi, .875rem)",
      "lineHeight": 1.45,
      "tracking": "0em",
      "use": "Literal filenames, code and machine identifiers"
    }
  }
}
